generator client {
  provider     = "prisma-client"
  output       = "../apps/backend/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AboutContent {
  id        String      @id @default(uuid())
  title     String
  text      String
  facts     AboutFact[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AboutFact {
  id       String       @id @default(uuid())
  icon     String
  title    String
  text     String
  order    Int
  isActive Boolean      @default(true)
  aboutId  String
  about    AboutContent @relation(fields: [aboutId], references: [id], onDelete: Cascade)
}

model Benefit {
  id        String   @id @default(uuid())
  icon      String
  title     String
  text      String
  order     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Direction {
  id        String          @id @default(uuid())
  icon      String
  title     String
  order     Int
  isActive  Boolean         @default(true)
  items     DirectionItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model DirectionItem {
  id          String    @id @default(uuid())
  text        String
  order       Int
  isActive    Boolean   @default(true)
  directionId String
  direction   Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)
}

model Review {
  id           String   @id @default(uuid())
  text         String
  studentName  String
  studentClass String
  imageUrl     String?
  icon         String
  order        Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
