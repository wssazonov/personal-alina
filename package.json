{
    "name": "personal-alina",
    "version": "0.2.0",
    "private": true,
    "workspaces": [
        "apps/frontend",
        "apps/backend"
    ],
    "scripts": {
        "start": "npm run start:frontend",
        "start:frontend": "npm --workspace @alina/frontend run start",
        "start:backend": "npm run prisma:generate && npm --workspace @alina/backend run start:dev",
        "build": "npm run build:frontend && npm run build:backend",
        "build:frontend": "npm --workspace @alina/frontend run build",
        "build:backend": "npm run prisma:generate && npm --workspace @alina/backend run build",
        "docker:up": "docker compose up -d --build",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f",
        "lint": "eslint apps prisma prisma.config.ts --cache --cache-location .eslintcache --cache-strategy content",
        "lint:fix": "npm run lint -- --fix",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:seed": "prisma db seed"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "angular-eslint": "^21.4.0",
        "dotenv": "^17.2.3",
        "eslint": "^9.0.0",
        "prisma": "7.8.0",
        "tsx": "^4.20.6",
        "typescript-eslint": "^8.59.4"
    }
}
